{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Information"
    }
  },
  "AllowedHosts": "*",
  "Keycloak": {
    "Authority": "http://localhost:8080/realms/foodexpress",
    "Audience": "account"
  },
  "ReverseProxy": {
    "Routes": {
      "users-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/users/{**catch-all}"
        }
      },
      "auth-route": {
        "ClusterId": "users-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "restaurants-route": {
        "ClusterId": "restaurants-cluster",
        "Match": {
          "Path": "/api/restaurants/{**catch-all}"
        }
      },
      "dishes-route": {
        "ClusterId": "restaurants-cluster",
        "Match": {
          "Path": "/api/dishes/{**catch-all}"
        }
      },
      "categories-route": {
        "ClusterId": "restaurants-cluster",
        "Match": {
          "Path": "/api/categories/{**catch-all}"
        }
      },
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/api/orders/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "users-cluster": {
        "Destinations": {
          "users-api": {
            "Address": "http://localhost:5003/"
          }
        }
      },
      "restaurants-cluster": {
        "Destinations": {
          "restaurants-api": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "orders-cluster": {
        "Destinations": {
          "orders-api": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}
